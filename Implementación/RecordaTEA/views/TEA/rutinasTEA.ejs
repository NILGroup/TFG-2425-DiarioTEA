<%- include("navbarTEA") %>

    <body>
        <div class="container" id="conjuntoRutinas">
            <div class="row mt-5 justify-content-center align-items-center">
                <h3 class="text-center mb-3">Mis rutinas</h3>
                <% if (rutinas.length> 0) { %>
                    <% rutinas.forEach(function(item) { %>
                        <div class="col-md-3 col-xs-3">
                            <div class="card">
                                <a href="/rutinas/mis-rutinas/<%= item.id %>">
                                    <div class="card-body">
                                        <img src="/images/pictos/rutinas.png">
                                    </div>
                                    <h5 class="card-title text-center">
                                        <%= item.nombre %>
                                    </h5>
                                </a>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>

                                <span class="text-center mt-5">No tienes rutinas.</span>


            </div>
            <% } %>
        </div>
        </div>
    </body>