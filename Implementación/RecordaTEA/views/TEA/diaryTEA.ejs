<%-include ("navbarTEA")%>

<body>
    <section class="container" id="columnaVistaDiario">
        <div class="row mt-4">
            <div class="d-flex justify-content-center">
                <div class="card no-border d-flex text-center justify-content-center ">
                    <a class="nav-link" href="/diario/add-entrada">
                        <img class=" card-img boton-add-entry" src="/images/config/add.png"
                            alt="Añadir entrada al diario">
                    </a>
                    <p class="card-title texto-boton">AÑADIR ENTRADA</p>
                </div>
            </div>
            <hr class="my-4 bg-success">
            <% entradas.forEach(function(item) { %>
                <div class="">
                    <div class="d-flex align-items-center text-start">
                        <h1 class="mb-0 mt-0">
                            <%= item.fecha_registro %> -
                        </h1>
                        <h2 class="titulo-hora mb-0 mt-0 fs-3 ms-2">
                            <%= item.hora_registro %>
                        </h2>
                    </div>
                    <div class="d-flex gap-3 mt-4" id="<%=item.idEntrada%>">
                        <% if(item.tipo){%>
                            <% item.tarjetas.forEach(function(picto) { %>
                          
                                <div class=" card tamaño-lista">
                                    <img class="card-img-top" src="<%= picto.enlace || picto.imagen %>">
                                </div>
                            
                                <% tarjetaEmocion = picto; %>
                            
                        <% }); %>
                        <%} else{ %>
                            <div class="me-2">
                                <p class="parrafo"><%= item.cuerpo %></p>
                            </div>

                        <%}%>

                        <!-- Contenedor d-flex para alinear las tarjetas -->
                        <div class="d-flex align-items-center gap-3 ms-auto">
                            <!-- Tarjeta de emoción, si existe -->
                            <% if (item.emocion!=null) { %>
                                <div class="card tamaño-lista">
                                    <img class="card-img-top" src="<%= item.emocion %>">
                                </div>
                            <% } %>

                            <!-- Tarjeta de Ver entrada -->
                            <div class="card no-border tamaño-lista d-flex text-center">
                                <a href="/diario/view-entry/<%= item.idEntrada %>">
                                    <img class="card-img-top" src="/images/config/ir.png"
                                        alt="Ver entrada del diario">
                                </a>
                                <p class="card-title texto-boton">VER</p>
                            </div>

                            <!-- Tarjeta de Borrar -->
                            <div class="card no-border tamaño-lista d-flex text-center">
                                <a href="#">
                                    <img class="card-img-top " src="/images/config/botonBorrar.png"
                                        alt="Borrar entrada">
                                </a>
                                <p class="card-title texto-boton">BORRAR</p>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4 bg-success mt-5">
                <% }); %>
            </div>
        </section>
    </body>
