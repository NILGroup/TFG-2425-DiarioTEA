<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RecordaTEA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.4.0/font/bootstrap-icons.min.css">

        <link rel="stylesheet" href="/stylesheets/indexStyle.css">
        <link rel="stylesheet" href="/stylesheets/index.css">
        <link rel="stylesheet" href="/stylesheets/cuidadores.css">
    <!--JQUERY-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>

<body>
    <nav class="navbar navbar-expand-lg navegacion align-items-center text-center">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNavCuidadores">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between" id="navbarNavCuidadores">
                <ul class="navbar-nav ">
                    <a href="#">
                        <h1 class="recordaTEA">RecordaTEA</h1>
                    </a>
                </ul>

            <ul class="navbar-nav">
                <li class="nav-item dropdown test">
                    <a class="nav-link dropdown-toggle d-flex align-items-center item-perfil" href="#" id="perfilDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span><%= data.nombre %> <i class="bi bi-person-circle"></i> </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="perfilDropdown">
                        <li><a class="dropdown-item text-danger" href="/cuidadores/logout"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a></li>
                    </ul>
                </li>
            </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <h2 class="text-center mt-4 titulos-1">Mis usuarios</h2>
        <div class="row mt-5 justify-content-center align-items-center">
            <% if (data.usuarios.length > 0) { %>
                <% data.usuarios.forEach(function(elem){ %>
                    <div class="col-md-3 col-xs-3">
                        <a href="diary/<%= elem.id %>">
                            <div class="card card-usuarios">
                                <h5 class="card-title text-center"><%= elem.nombre %></h5>
                                <div class="card-body"></div>
                            </div>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <p>Todavía no tienes ningún usuario asignado.</p>
            <% } %>
            
        </div>
    </div>
</body>

</html>