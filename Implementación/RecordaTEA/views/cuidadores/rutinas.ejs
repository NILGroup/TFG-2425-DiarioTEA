<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rutinas de  <%= nombre %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.4.0/font/bootstrap-icons.min.css">
    <link href="https://cdn.lineicons.com/4.0/lineicons.css" rel="stylesheet" />

    <link rel="stylesheet" href="/stylesheets/index.css">
    <link rel="stylesheet" href="/stylesheets/cuidadores.css">
    <!--JQUERY-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>

<body>
    <%-include ("navbar", { nombreUsuario: nombre })%>

        <div class="container text-center margen">
            <div class="row mt-4">
                <h1 class="titulos-1">Rutinas de <%= nombre %></h1>
            </div>
            <div class="row mt-3">
                <div class="d-flex justify-content-end">
                    <a href="/rutinas/addRutina" class="btn btn-borde">Crear Rutina</a>
                </div>
            </div>

        </div>
        <div class="container d-flex mt-3">
            <div class="row">
                <% if (rutinas.length> 0) { %>
                    <% rutinas.forEach(function(item) { %>
                        <div class="col-md-3 col-xs-3">
                            <div class="card">
                                <a href="/rutinas/<%= item.id %>">
                                    <div class="card-body">
                                        <img src="/images/pictos/rutinas.png">
                                    </div>
                                    <h5 class="card-title text-center">
                                        <%= item.nombre %>
                                    </h5>
                                </a>
                            </div>
                        </div>
                        <% }); %>
            </div>

        </div>
        <%} else{%>

            <div class="row mt-3 d-flex align-items-center justify-content-center texto-centro">
                <p class="fs-5"><%= nombre %> todavía no tiene rutinas.</p>
            </div>



            <%}%>





</body>