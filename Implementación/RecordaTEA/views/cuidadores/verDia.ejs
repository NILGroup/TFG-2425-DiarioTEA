<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diario de Juan</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.4.0/font/bootstrap-icons.min.css">
    <link href="https://cdn.lineicons.com/4.0/lineicons.css" rel="stylesheet" />

    <link rel="stylesheet" href="/stylesheets/index.css">
    <link rel="stylesheet" href="/stylesheets/cuidadores.css">
    <!--JQUERY-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>

<body>
    <%-include ("navbar", { nombreUsuario: data.usuario.nombre })%>
        <main class="container margen">
            <div class="row mt-4 text-center">
                <h1 class="titulos-1">Diario de <%= data.usuario.nombre %>
                </h1>
            </div>
            <div class="row list-group mt-5" id="">
                <div class="row d-flex align-items-center justify-content-between">
                    <h2 class="titulos-2 col-10">
                        <%= data.dia %>
                    </h2>
                    <a href="/diario" class="btn btn-borde col-2" id="consultaMes">Volver al mes</a>
                </div>
                <% if (data.entradas.length> 0) { %>
                    <% data.entradas.forEach(function(elem){%>
                        <div class="d-flex align-items-center tarjeta-diario mt-5">
                            <div class="list-group-item list-hora flex-column align-items-center entrada">
                                <div class="justify-content-center text-center">
                                    <h2>
                                        <%= elem.hora %>
                                    </h2>
                                    <p>
                                        <%= elem.autor.nombre %>
                                    </p>
                                </div>
                            </div>
                            <div class="list-group-item list-contenido d-flex flex-column justify-content-center align-items-start entrada">
                                <div class="align-items-center">
                                    <div class="img-registro gap-3">
                                        <% if (elem.cuerpo===null){%>
                                            <% elem.pictos.forEach(function(p){%>
                                                <img src="<%= p.enlace %>" alt="">

                                                <%}) %>
                                    </div>
                                    <%} else {%>
                                        <div class="d-flex align-items-center text-center">
                                            <p class="no-margen">
                                                <%= elem.cuerpo%>
                                            </p>
                                        </div>
                                        <%}%>
                                </div>
                            </div>
                        </div>
                        <%})%>
                            <%}%>
            </div>

        </main>
        </div>
        <script src="/javascripts/verDia.js"></script>
</body>

</html>