<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diario de Juan</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.4.0/font/bootstrap-icons.min.css">
    <link href="https://cdn.lineicons.com/4.0/lineicons.css" rel="stylesheet" />

    <link rel="stylesheet" href="stylesheets/index.css">
    <link rel="stylesheet" href="stylesheets/cuidadores.css">
    <!--JQUERY-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>

<body>
    <%-include ("navbar",  { nombreUsuario: data.usuario.nombre })%>
        <main class="container margen">
            <div class="row mt-4 text-center">
                <h1 class="titulos-1">Diario de <%= data.usuario.nombre %></h1>
            </div>
            <div class="row list-group mt-5" id="consultaDiario">
                <% if (data.entradas.length> 0) { %>
                    <% data.entradas.forEach(function(elem){%>
                        <a href="#" id="consultaDia2">
                            <div class="d-flex align-items-center tarjeta-diario <%= elem.hoy ? 'hoy' : '' %>">
                                <div class="list-group-item list-dia flex-column align-items-center entrada">
                                    <div class="flex justify-content-center text-center">
                                        <h2><%= elem.dia %></h2>
                                        <h3><%= elem.mes %></h3>
                                    </div>
                                </div>
                                <div class="list-group-item list-contenido flex-column align-items-start entrada" >
                                    <div class="d-flex w-100 justify-content-between">
                                        <h5 class="mb-1 texto-diario"><%= elem.f %> (<%= elem.entradas %> <%= elem.entradas === 1 ? 'registro' : 'registros' %>)</h5>
                                        <small>
                                            <% 
                                                const hoy = new Date(); 
                                                const fechaElem = new Date(elem.fecha); 
                                                
                                                const diffTiempo = hoy - fechaElem;
                                                const diffDias = Math.floor(diffTiempo / (1000 * 60 * 60 * 24)); 
                                        
                                                let textoFecha;
                                                if (diffDias === 0) {
                                                    textoFecha = "Hoy";
                                                } else if (diffDias === 1) {
                                                    textoFecha = "Hace 1 día";
                                                } else {
                                                    textoFecha = `Hace ${diffDias} días`;
                                                }
                                            %>
                                            <%= textoFecha %>
                                        </small>
                                    </div>
                                    <p class="mb-1 texto-diario">Último registro:</p>
                                    <div class="img-registro gap-3">
                                        <% if (elem.cuerpo === null){%>
                                            <% elem.pictos.forEach(function(p){%>
                                                <img src="<%=p.enlace%>" alt="">
                                               <%}) %>
                                        <%} else {%>
                                            <div class="d-flex">
                                                <p class="align-items-center"><%= elem.cuerpo%></p>
                                            </div>
                                            <%}%>
                                    </div>
                                </div>
                            </div>
                        </a>
                        <%})%>
                    <% } else { %>
                        <div class="col-12 text-center">
                            <p class="texto-diario">El diario de <%= data.usuario.nombre %> esta vacío</p>
                        </div>
                        <%}%>
            </div>

        </main>
    </div>
    <script src="javascripts/diary.js"></script>
</body>

</html>