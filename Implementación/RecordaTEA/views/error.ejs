<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/stylesheets/styles.css">
    <link rel="stylesheet" href="/stylesheets/cuidadores.css">
    <link rel="stylesheet" href="/stylesheets/login.css">
    <link rel="stylesheet" href="/stylesheets/error.css">
    <title>ERROR <%=error.status%></title>
</head>
<body>
    <!--PLANTILLA PARA CUALQUIER ERROR QUE TENGAMOS DEFINIDO-->
    <div class="container d-flex flex-column vh-100">
        <h1 class="recordaTEA text-center color-tit mt-0 pt-4">RecordaTEA</h1>
        <div class="container d-flex text-center align-items-center flex-column flex-grow-1 justify-content-center mt-0 ">
            <% if(error.status == 404){%>
                <h2 class="error">Oops.</h2>
                <span class="texto-error">Página no encontrada.</span>
           <% } %>
            <span class="texto-error">Para volver a inicio pulse <a href="/"><b>aqui</b></a></span>
        </div>
    </div>
</body>
</html>