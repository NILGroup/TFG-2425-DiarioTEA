<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionar tarjetas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.4.0/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="stylesheets/indexStyle.css">
    <link rel="stylesheet" href="stylesheets/index.css">
    <link rel="stylesheet" href="stylesheets/cuidadores.css">
    <!--JQUERY-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>

<body>
    <%-include ("navbar", { nombreUsuario: data.usuario.nombre })%>
        <div class="main-container d-flex mt-3">
            <div class="container margen-manage" id="containerPrincipal">
                <div class="btn-group manage-btn-group" role="group" aria-label="Opciones de seleccion de pictos">
                    <button type="button" class="btn manage-buttons seleccion">Pictogramas</button>
                </div>

                <div class="row p-3 borde">
                    <div class="row">
                        <form method="GET" action="" class="d-flex" id="buscadorARASAAC">
                            <input class="form-control me-2" type="search" placeholder="Buscar pictogramas en ARASAAC"
                                aria-label="Buscar pictogramas en ARASAAC" name="consulta" required id="campoBusqueda">
                            <button class="btn btn-background" type="" id="buscaArasaac">Buscar</button>
                        </form>
                    </div>

                    <div class="row mt-5" id="matrizBusqueda" style="display: none;">
                        <div class="d-flex justify-content-center text-center" id="avisos">
                            <div id="cargando" class="spinner-border cargando" role="status" style="display: none;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <div class="container">
                            <div class="row pb-3" id="resultBusqueda" style="display: none;">

                            </div>
                            <div class="row mt-2" style="display: none;" id="paginas">
                                <div class="d-flex justify-content-center text-center">
                                    <nav aria-label="" class="text-center">
                                        <ul class="pagination">
                                            <li class="page-item"><button class="page-link btn-borde" href="#"
                                                    id="anteriorPag">Anterior</button>
                                            </li>
                                            <li class="page-item"><button class="page-link btn-borde" href="#"
                                                    id="siguientePag">Siguiente</button></li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-5">
                        <h1 class="titulos-2">Vocabulario de <%= data.usuario.nombre %>:</h1>
                        <div class="container mt-3 borde-cont">
                            <div class="row pb-3" id="contenedorPictogramas">
                                <% if (data.voc.length> 0) { %>
                                    <% data.voc.forEach(function(elem){%>
                                        <div class="col-lg-2 col-md-3 mt-3">
                                            <div class="dflex">
                                                <div class="card">
                                                    <a href="">
                                                        <img src="<%= elem.enlace%>" class="card-img">
                                                    </a>
                                                    <div class="remove-picto"></div>
                                                    <span id="<%= elem.id %>" class="trash"><i
                                                            class="bi bi-trash3-fill"></i></span>
                                                </div>
                                            </div>

                                        </div>
                                        <% }) %>
                                            <% } else {%>
                                                <div class="d-flex text-center justify-content-center align-items-center"
                                                    id="no-pictos">
                                                    <span>
                                                        <%= data.usuario.nombre %> todavía no tiene pictogramas
                                                    </span>
                                                </div>
                                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="avisosPictos">
                </div>
                <div class="row finale"></div>
            </div>
        </div>
        <script src="javascripts/manageCardsTablero.js"></script>
</body>

</html>